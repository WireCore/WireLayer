{
    "name": "@wirecore/wirelayer-mcp",
    "version": "0.3.2",
    "description": "MCP server with the WireLayer component API and guides for AI assistants",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WireCore/WireLayer.git",
        "directory": "packages/mcp"
    },
    "homepage": "https://github.com/WireCore/WireLayer#readme",
    "bugs": {
        "url": "https://github.com/WireCore/WireLayer/issues"
    },
    "type": "module",
    "bin": {
        "wirelayer-mcp": "./dist/cli.js",
        "wirecore-mcp": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist",
        "data"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "collect": "node scripts/collect.ts",
        "typecheck": "tsc --noEmit",
        "test": "node scripts/collect.ts --check && vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vue/compiler-sfc": "^3.5.44",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5"
    }
}
