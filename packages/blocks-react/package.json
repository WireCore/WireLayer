{
    "name": "@wirecore/wirelayer-blocks-react",
    "version": "0.1.0",
    "description": "Page blocks for React (site header, CTA section, mode toggle, sign-in form and layout) and the condition builder, built on @wirecore/wirelayer-react",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wirecore/wirelayer.git",
        "directory": "packages/blocks-react"
    },
    "homepage": "https://github.com/wirecore/wirelayer#readme",
    "bugs": {
        "url": "https://github.com/wirecore/wirelayer/issues"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "wirecore:source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@wirecore/wirelayer-react": "workspace:^",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "@ark-ui/react": "^5.39.3",
        "@wirecore/wirelayer-recipes": "workspace:^",
        "lucide-react": "^1.59.0"
    },
    "devDependencies": {
        "@storybook/react-vite": "^10.6.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@wirecore/wirelayer-react": "workspace:*",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.4"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    }
}
