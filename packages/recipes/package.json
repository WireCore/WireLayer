{
    "name": "@wirecore/wirelayer-recipes",
    "version": "0.8.1",
    "description": "Framework-agnostic WireLayer component recipes (tailwind-variants)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WireCore/WireLayer.git",
        "directory": "packages/recipes"
    },
    "homepage": "https://github.com/WireCore/WireLayer#readme",
    "bugs": {
        "url": "https://github.com/WireCore/WireLayer/issues"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "wirecore:source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./native": {
            "wirecore:source": "./src/native/index.ts",
            "types": "./dist/native/index.d.ts",
            "default": "./dist/native/index.js"
        },
        "./locales/*": {
            "wirecore:source": "./src/locales/*.ts",
            "types": "./dist/locales/*.d.ts",
            "default": "./dist/locales/*.js"
        },
        "./vite": {
            "wirecore:source": "./src/vite.ts",
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./tailwind.css": "./tailwind.css",
        "./sources/*": "./dist/sources/*",
        "./native.css": "./native.css"
    },
    "files": [
        "dist",
        "src",
        "tailwind.css",
        "native.css"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ../../scripts/sources.ts recipes",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1"
    },
    "peerDependencies": {
        "vite": ">=7"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "~6.0.3",
        "vite": "^8.3.4"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./native": {
                "types": "./dist/native/index.d.ts",
                "default": "./dist/native/index.js"
            },
            "./locales/*": {
                "types": "./dist/locales/*.d.ts",
                "default": "./dist/locales/*.js"
            },
            "./vite": {
                "types": "./dist/vite.d.ts",
                "default": "./dist/vite.js"
            },
            "./tailwind.css": "./tailwind.css",
            "./sources/*": "./dist/sources/*",
            "./native.css": "./native.css"
        }
    }
}
