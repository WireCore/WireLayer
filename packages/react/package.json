{
    "name": "@wirecore/wirelayer-react",
    "version": "0.5.0",
    "description": "WireLayer components for React",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WireCore/WireLayer.git",
        "directory": "packages/react"
    },
    "homepage": "https://github.com/WireCore/WireLayer#readme",
    "bugs": {
        "url": "https://github.com/WireCore/WireLayer/issues"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "wirecore:source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./form": {
            "wirecore:source": "./src/form/index.ts",
            "types": "./dist/form/index.d.ts",
            "default": "./dist/form.js"
        },
        "./data-table": {
            "wirecore:source": "./src/data-table/index.ts",
            "types": "./dist/data-table/index.d.ts",
            "default": "./dist/data-table.js"
        },
        "./virtual": {
            "wirecore:source": "./src/virtual/index.ts",
            "types": "./dist/virtual/index.d.ts",
            "default": "./dist/virtual.js"
        },
        "./chart": {
            "wirecore:source": "./src/chart/index.ts",
            "types": "./dist/chart/index.d.ts",
            "default": "./dist/chart.js"
        },
        "./editor": {
            "wirecore:source": "./src/editor/index.ts",
            "types": "./dist/editor/index.d.ts",
            "default": "./dist/editor.js"
        },
        "./code": {
            "wirecore:source": "./src/code/index.ts",
            "types": "./dist/code/index.d.ts",
            "default": "./dist/code.js"
        },
        "./pdf": {
            "wirecore:source": "./src/pdf/index.ts",
            "types": "./dist/pdf/index.d.ts",
            "default": "./dist/pdf.js"
        },
        "./locales/*": {
            "wirecore:source": "./src/locales/*.ts",
            "types": "./dist/locales/*.d.ts",
            "default": "./dist/locales/*.js"
        },
        "./styles.css": "./styles.css",
        "./styles-core.css": "./styles-core.css",
        "./sources/*": "./dist/sources/*"
    },
    "files": [
        "dist",
        "styles.css",
        "styles-core.css",
        "llms.txt",
        "llms-full.txt"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/sources.ts components && node ../../scripts/llms.ts react",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6008 --host 0.0.0.0 --no-open",
        "build-storybook": "storybook build"
    },
